{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinGitHubActionDigests"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Ship GitHub Actions updates together so the Node runtime stays current.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
